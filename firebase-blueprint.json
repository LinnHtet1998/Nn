{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Authenticated user profile, active company pointer, trusted server clock anchor, and localization preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "activeCompanyId": { "type": "string" },
        "preferredLanguage": { "type": "string", "enum": ["my", "en"] },
        "preferredTheme": { "type": "string", "enum": ["system", "light", "dark"] },
        "lastServerTimeAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "displayName", "preferredLanguage", "preferredTheme", "createdAt", "updatedAt"]
    },
    "SubscriptionPlan": {
      "title": "SaaS Subscription Plan",
      "description": "Super Admin configurable subscription tier (1 Month, 6 Months, 1 Year, or custom) priced in MMK.",
      "type": "object",
      "properties": {
        "nameEn": { "type": "string" },
        "nameMm": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "descriptionMm": { "type": "string" },
        "durationMonths": { "type": "integer" },
        "durationDays": { "type": "integer" },
        "priceMmk": { "type": "integer" },
        "discountPercent": { "type": "number" },
        "promoPriceMmk": { "type": "integer" },
        "promoLabel": { "type": "string" },
        "maxBranches": { "type": "integer" },
        "maxEmployees": { "type": "integer" },
        "enabledFeatures": { "type": "array" },
        "isActive": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nameEn", "nameMm", "durationMonths", "durationDays", "priceMmk", "discountPercent", "promoPriceMmk", "maxBranches", "maxEmployees", "enabledFeatures", "isActive", "sortOrder", "createdBy", "createdAt", "updatedAt"]
    },
    "PaymentMethodConfig": {
      "title": "Configurable Payment Method",
      "description": "Manual transfer or future gateway webhook payment method configured by Platform Super Admin.",
      "type": "object",
      "properties": {
        "nameEn": { "type": "string" },
        "nameMm": { "type": "string" },
        "providerType": { "type": "string", "enum": ["MANUAL_TRANSFER", "GATEWAY_WEBHOOK"] },
        "accountTitle": { "type": "string" },
        "accountNumber": { "type": "string" },
        "instructionsEn": { "type": "string" },
        "instructionsMm": { "type": "string" },
        "gatewayEndpoint": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nameEn", "nameMm", "providerType", "accountTitle", "accountNumber", "instructionsEn", "instructionsMm", "isActive", "createdBy", "createdAt", "updatedAt"]
    },
    "SubscriptionPayment": {
      "title": "Subscription Payment Record",
      "description": "Payment submission with receipt proof, transaction reference, and Super Admin verification status.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "companyName": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "planId": { "type": "string" },
        "planNameEn": { "type": "string" },
        "planNameMm": { "type": "string" },
        "durationMonths": { "type": "integer" },
        "durationDays": { "type": "integer" },
        "amountMmk": { "type": "integer" },
        "paymentMethodId": { "type": "string" },
        "paymentMethodName": { "type": "string" },
        "transactionRef": { "type": "string" },
        "paymentDateText": { "type": "string" },
        "proofImageBase64": { "type": "string" },
        "proofStorageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING_VERIFICATION", "VERIFIED", "REJECTED"] },
        "receiptNumber": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "grantedStartAt": { "type": "string", "format": "date-time" },
        "grantedExpiresAt": { "type": "string", "format": "date-time" },
        "verifiedByUid": { "type": "string" },
        "verifiedByName": { "type": "string" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "companyName", "ownerUid", "ownerName", "ownerEmail", "planId", "planNameEn", "planNameMm", "durationMonths", "durationDays", "amountMmk", "paymentMethodId", "paymentMethodName", "transactionRef", "paymentDateText", "status", "receiptNumber", "createdBy", "createdAt", "updatedAt"]
    },
    "PlatformAuditLog": {
      "title": "Platform Billing & Security Audit Log",
      "description": "Immutable platform-wide audit trail for plan edits, payments, verifications, renewals, and suspensions.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "ownerUid", "actorUid", "actorName", "actorRole", "action", "targetType", "targetId", "details", "createdBy", "createdAt"]
    },
    "AccountDirectory": {
      "title": "Owner-Controlled Account Directory",
      "description": "Authoritative owner-provisioned employee authorization record keyed by sanitized lowercase email.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "employeeId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "SUSPENDED", "REVOKED"] },
        "allBranchesAccess": { "type": "boolean" },
        "assignedBranchIds": { "type": "array" },
        "linkedUid": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "ownerUid", "employeeId", "email", "displayName", "phone", "role", "status", "allBranchesAccess", "assignedBranchIds", "createdBy", "createdAt", "updatedAt"]
    },
    "Company": {
      "title": "Company",
      "description": "Multi-tenant subscribing retail business root document with plan quotas and subscription lifecycle.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "name": { "type": "string" },
        "nameMm": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "taxId": { "type": "string" },
        "currency": { "type": "string", "enum": ["MMK"] },
        "defaultLanguage": { "type": "string", "enum": ["my", "en"] },
        "taxRatePercent": { "type": "number" },
        "allowNegativeStock": { "type": "boolean" },
        "offlineLimitMmk": { "type": "integer" },
        "subscriptionPlanId": { "type": "string" },
        "subscriptionPlanName": { "type": "string" },
        "subscriptionStatus": { "type": "string", "enum": ["PENDING_PAYMENT", "PENDING_APPROVAL", "ACTIVE", "EXPIRING_SOON", "EXPIRED", "SUSPENDED", "CANCELLED"] },
        "subscriptionStartAt": { "type": "string", "format": "date-time" },
        "subscriptionExpiresAt": { "type": "string", "format": "date-time" },
        "maxBranchesAllowed": { "type": "integer" },
        "maxEmployeesAllowed": { "type": "integer" },
        "enabledFeatures": { "type": "array" },
        "activeBranchCount": { "type": "integer" },
        "activeEmployeeCount": { "type": "integer" },
        "expiryNotified7d": { "type": "boolean" },
        "expiryNotified3d": { "type": "boolean" },
        "expiryNotified1d": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "ownerName", "ownerEmail", "name", "nameMm", "phone", "address", "currency", "defaultLanguage", "taxRatePercent", "allowNegativeStock", "offlineLimitMmk", "subscriptionPlanId", "subscriptionPlanName", "subscriptionStatus", "maxBranchesAllowed", "maxEmployeesAllowed", "enabledFeatures", "activeBranchCount", "activeEmployeeCount", "createdBy", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserProfile" } },
    "/subscription_plans/{planId}": { "schema": { "$ref": "#/entities/SubscriptionPlan" } },
    "/payment_methods/{methodId}": { "schema": { "$ref": "#/entities/PaymentMethodConfig" } },
    "/subscription_payments/{paymentId}": { "schema": { "$ref": "#/entities/SubscriptionPayment" } },
    "/platform_audit_logs/{logId}": { "schema": { "$ref": "#/entities/PlatformAuditLog" } },
    "/account_directory/{emailKey}": { "schema": { "$ref": "#/entities/AccountDirectory" } },
    "/companies/{companyId}": { "schema": { "$ref": "#/entities/Company" } }
  }
}
